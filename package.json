{
  "name": "camino-seguro-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20 <23",
    "pnpm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "invariants": "node scripts/check-invariants.mjs",
    "specs:check": "node scripts/check-invariants.mjs --specs-only",
    "verify": "node scripts/verify.mjs",
    "sync:backend-ref": "node scripts/sync-backend-ref.mjs",
    "sync:backend-ref:check": "node scripts/sync-backend-ref.mjs --check",
    "contracts:generate": "pnpm --filter @camino/contracts generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
