{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["./AGENTS.md", "./docs/backend-ref/README.md"],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    },
    "edit": {
      "*": "ask",
      "LICENSE": "deny",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "bash scripts/*": "allow",
      "git push *": "deny",
      "rm -rf *": "deny",
      "curl *": "deny"
    }
  }
}
