  "info": {
    "title": "Backend API Core",
    "description": "Servicio base API en NestJS con arquitectura limpia",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "coordinacion@sanbenito.edu.co",
            "description": "Correo electrónico institucional"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "ContrasenaSegura#2026",
            "description": "Contraseña del usuario"
          }
        },
        "required": ["email", "password"]
      }
    }
  }
