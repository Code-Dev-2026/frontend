# Camino Seguro Frontend environment template
# Este archivo reemplaza valores sensibles por placeholders seguros.

# Frontend app
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_OPENAPI_URL=http://localhost:3000/api-json
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_FIREBASE_PROJECT_ID=camino-seguro-demo
NEXT_PUBLIC_APP_NAME=Camino Seguro

# Mobile apps
# El emulador Android alcanza la máquina anfitriona en 10.0.2.2.
# Para el simulador de iOS o un dispositivo físico usa la IP de tu máquina.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_MODE=real
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3001
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json
EXPO_PUBLIC_FIREBASE_PROJECT_ID=camino-seguro-demo
EXPO_PUBLIC_APP_ENV=development
